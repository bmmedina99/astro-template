{
  "name": "astro-template",
  "description": "Plantilla base de Astro con TailwindCSS y TypeScript preconfigurados",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro build",
    "preview": "astro preview --port=5000",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.7",
    "astro": "5.8.0",
    "tailwindcss": "4.1.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.15.23",
    "sharp": "0.34.2",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.11.0"
}
