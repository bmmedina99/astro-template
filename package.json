{
  "name": "astrokit",
  "description": "Plantilla de Astro para crear sitios web estáticos rápidos; optimizada para SEO y accesibilidad, preconfigurada con TailwindCSS y TypeScript.",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro check && astro build",
    "release": "pnpm dlx semantic-release",
    "preview": "astro preview --port=5000",
    "fmt": "biome format --write .",
    "lint": "biome lint --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/astrokit.git"
  },
  "bugs": {
    "url": "https://github.com/bmmedina99/astrokit/issues"
  },
  "dependencies": {
    "astro": "6.4.4",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "@biomejs/biome": "2.4.16",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.2",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "sharp": "0.34.5"
  },
  "packageManager": "pnpm@11.3.0"
}
