{
  "name": "astrokit",
  "description": "Plantilla de inicio ultra-ligera para proyectos con Astro, preconfigurada con TypeScript y TailwindCSS.",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro check && astro build",
    "release": "pnpm dlx semantic-release",
    "preview": "astro preview --port=5000",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/astrokit.git"
  },
  "bugs": {
    "url": "https://github.com/bmmedina99/astrokit/issues"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.6.0",
    "@fontsource/poppins": "5.2.7",
    "@tailwindcss/vite": "4.1.16",
    "astro": "5.15.2",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "5.1.0",
    "schema-dts": "1.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.5",
    "@biomejs/biome": "2.3.2",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@types/node": "24.9.2",
    "sharp": "0.34.4",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.20.0"
}
