{
  "name": "astro-template",
  "description": "Plantilla base de Astro con TailwindCSS y TypeScript preconfigurados",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro build",
    "preview": "astro preview --port=5000",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "dependencies": {
    "astro": "5.7.12"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "sharp": "0.34.1"
  },
  "packageManager": "pnpm@10.10.0"
}
