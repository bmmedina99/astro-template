{
  "name": "astrokit",
  "description": "Plantilla de inicio ultra-ligera para proyectos con Astro, preconfigurada con TypeScript y TailwindCSS.",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --port=4000",
    "build": "astro build",
    "preview": "astro preview --port=5000",
    "fmt": "pnpm biome format --write .",
    "lint": "pnpm biome lint --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmmedina99/astrokit.git"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.4.1",
    "@tailwindcss/vite": "4.1.8",
    "astro": "5.9.1",
    "astro-robots-txt": "1.0.0",
    "astro-seo-schema": "5.0.0",
    "schema-dts": "1.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/npm": "12.0.1",
    "@types/node": "22.15.30",
    "sharp": "0.34.2",
    "tailwindcss": "4.1.8",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.11.1"
}
