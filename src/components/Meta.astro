---
import { configSite } from '@/site.config'
import globalCSS from '@/styles/global.css?url'
import { Schema } from 'astro-seo-schema'

const canonicalURL = new URL(Astro.request.url, Astro.site).toString()
const { title, description } = Astro.props
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Precarga la fuentes de public/fonts o de @fontsource -->
<link
  rel="preload"
  href="./fonts/fuente.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- Critical CSS + Fuentes  -->
<style>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 3rem;
  }
  @font-face {
    font-family: "Fuente";
    font-style: normal;
    font-display: swap;
    font-weight: 400;
    src: url(./fonts/fuente.woff2) format("woff2");
  }
</style>

<!-- Carga el CSS generado de manera asincrona -->
<link rel="preload" href={globalCSS} as="style" onload="this.onload=null;this.rel='stylesheet'" />

<!-- Datos del sitio -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow">
<meta name="author" content={configSite.author} />

<!-- Open Graph - Imagen 1200x630 recomendado -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="bmmedina.dev" />
<meta property="og:image" content=`${canonicalURL}/images/open-graph.webp` />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content="website" />

<!-- Twitter Card - Imagen 1200x675 para summary_large_image recomendado -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content=`${canonicalURL}/images/twitter-card.webp` />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:site" content="@twiter-site" />
<meta property="twitter:creator" content="@twitter-author" />

<!-- Propiedades + Favicon -->
<meta name="theme-color" content="#003014" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={canonicalURL} />

<!-- Configura el schema según el tipo de sitio: https://schema.org/docs/full.html -->
<Schema item={{
  "@context": "https://schema.org",
  "@type": "Person",
  name: configSite.author,
  url: canonicalURL,
  description: description,
}} />
