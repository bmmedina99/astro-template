---
import Icon from '../ui/Icon.astro'
---

<section class="px-4 py-24">
  <div class="container mx-auto text-center">
    <p class="mb-4 text-xs text-gray-300 md:text-sm">src/components/sections/Hero.astro</p>
    <h1 class="mb-6 text-5xl font-bold leading-tight text-white md:text-7xl">
      AstroKit
      <span
        class="block text-transparent bg-clip-text bg-gradient-to-t from-orange-pantone to-medium-slate-blue"
      >
        Template
      </span>
    </h1>
    <p class="max-w-3xl mx-auto mb-8 text-xl leading-relaxed text-slate-300">
      Plantilla de inicio ultra-ligera para proyectos con Astro, preconfigurada con
      <span class="font-semibold text-orange-400"> TypeScript</span> y
      <span class="font-semibold text-purple-400"> TailwindCSS</span>. Lista
      para usar en segundos.
    </p>
    <div class="flex items-center justify-center">
      <a
        href="https://github.com/new?template_name=astrokit&template_owner=bmmedina99"
        target="_blank"
        rel="noopener noreferrer"
        class="flex gap-4 px-4 py-3 text-white border-0 rounded-md bg-gradient-to-r from-orange-500 to-purple-600 hover:from-orange-600 hover:to-purple-700"
      >
        <Icon name="template" />
        Usar Template
      </a>
    </div>
  </div>
</section>
