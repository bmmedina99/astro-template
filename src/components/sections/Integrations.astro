---
import { integrationsAvailable, integrationsInstalled } from '@/site.config'
import Icon from '../ui/Icon.astro'
---

<section id="integrations" class="px-4 py-20 bg-slate-900/50">
  <div class="container mx-auto">
    <div class="mb-4 text-center">
      <p class="mb-2 text-xs text-gray-300 md:text-sm">
        src/components/section/Integrations.astro
      </p>
      <h2 class="mb-4 text-4xl font-bold text-white">
        Integraciones Instaladas
      </h2>
      <p class="text-lg text-slate-300">
        En este template, ya vienen preinstaladas las siguientes
      </p>
    </div>
    <div class="grid max-w-6xl gap-6 mx-auto md:grid-cols-3">
      {
        integrationsInstalled.map((integrations) => (
          <div class="flex flex-col items-center p-6 text-center transition-colors duration-300 border rounded-lg bg-slate-800/30 border-slate-700">
            <div
              class={`flex items-center justify-center w-12 h-12 mb-4 rounded-lg ${integrations.background}`}
            >
              <Icon name={integrations.icon} class="text-white" />
            </div>
            <h3 class="font-semibold text-white">{integrations.name}</h3>
            <p class="text-sm text-slate-300 text-pretty">{integrations.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 mb-4 text-center">
      <h2 class="mb-4 text-4xl font-bold text-white">
        Integraciones Disponibles
      </h2>
      <p class="text-lg text-slate-300">
        Con Astro puedes usar los frameworks más populares de JavaScript
      </p>
    </div>
    <div class="grid max-w-6xl gap-6 mx-auto md:grid-cols-2 lg:grid-cols-4">
      {
        integrationsAvailable.map((integrations) => (
          <div class="flex flex-col items-center p-6 text-center transition-colors duration-300 border rounded-lg bg-slate-800/30 border-slate-700">
            <div
              class={`flex items-center justify-center w-12 h-12 mb-4 rounded-lg ${integrations.background}`}
            >
              <Icon name={integrations.icon} class="text-white" />
            </div>
            <h3 class="font-semibold text-white">{integrations.name}</h3>
            <p class="text-sm text-slate-300 text-pretty">{integrations.description}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-12 text-center">
      <p class="text-sm text-slate-300">
        Agrega cualquier integración ofical de Astro con un simple comando:
        <code class="px-2 py-1 text-orange-400 rounded bg-slate-800">
          pnpm astro add [integración]
        </code>
      </p>
    </div>
  </div>
</section>
