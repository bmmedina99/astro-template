---
import Main from '@/components/layout/Main.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout title="404">
  <Main class="flex items-center justify-center flex-grow overflow-hidden">
    <div class="relative z-10 max-w-4xl mx-auto space-y-4 text-center">
      <p class="mb-4 text-xs text-gray-300 md:text-sm">src/pages/404.astro</p>
      <p
        class="text-6xl font-bold leading-none text-transparent sm:text-8xl bg-clip-text bg-gradient-to-t from-orange-pantone to-medium-slate-blue"
      >
        404
      </p>
      <section class="space-y-4">
        <h1 class="font-bold text-white">Página no encontrada</h1>
        <p class="max-w-2xl mx-auto text-xl leading-relaxed text-slate-300">
          Lo sentimos, la página que estás buscando no existe o ha sido movida.
          Pero no te preocupes, hay muchas otras cosas increíbles que puedes
          explorar.
        </p>
      </section>
      <div class="flex items-center justify-center">
        <button
          type="button"
          onclick="window.history.back()"
          class="flex gap-4 px-4 py-3 text-black border-0 rounded-md bg-gradient-to-r from-orange-500 to-purple-600 hover:from-orange-600 hover:to-purple-700"
        >
          Volver a la página anterior
        </button>
      </div>
    </div>
  </Main>
</Layout>
