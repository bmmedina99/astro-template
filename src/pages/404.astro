---
import Main from '@/components/layout/Main.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout
  title="Página no encontrada"
  description="Lo sentimos, la página que estás buscando no existe o ha sido movida. Pero no te preocupes, hay muchas otras cosas increíbles que puedes explorar."
  robots
>
  <Main class="px-4 py-24">
    <div class="relative z-10 max-w-4xl mx-auto space-y-4 text-center">
      <p class="mb-4 text-xs text-gray-300 md:text-sm">src/pages/404.astro</p>
      <section class="space-y-4">
        <h1
          class="font-bold text-transparent bg-clip-text bg-linear-to-t from-orange-pantone to-medium-slate-blue"
        >
          Página no encontrada
        </h1>
        <p
          class="max-w-2xl mx-auto text-xl leading-relaxed text-slate-300 text-pretty"
        >
          Lo sentimos, la página que estás buscando no existe o ha sido movida.
          Pero no te preocupes, hay muchas otras cosas increíbles que puedes
          explorar.
        </p>
      </section>
      <div class="flex items-center justify-center">
        <button
          type="button"
          onclick="window.history.back()"
          class="flex gap-4 px-4 py-3 text-mauve-50 border-0 rounded-md bg-linear-to-r from-orange-500 to-purple-600 hover:from-orange-600 hover:to-purple-700"
        >
          Volver a la página anterior
        </button>
      </div>
    </div>
  </Main>
</Layout>
