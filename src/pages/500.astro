---
import Main from '@/components/layout/Main.astro'
import Layout from '@/layouts/Layout.astro'

const { error } = Astro.props
---

<Layout title="Error inesperado">
  <Main class="flex items-center justify-center grow overflow-hidden">
    <div class="max-w-2xl mx-auto space-y-4 text-center">
      <p class="mb-4 text-xs text-gray-300 md:text-sm">src/pages/500.astro</p>
      <section class="space-y-4">
        <h1
          class="font-bold text-transparent bg-linear-to-r from-orange-pantone to-medium-slate-blue bg-clip-text"
        >
          Oops!
        </h1>
        <h2 class="text-3xl font-semibold text-white">Algo salió mal</h2>
        <p class="max-w-md mx-auto text-lg leading-relaxed text-slate-300">
          Ha ocurrido un error inesperado. No te preocupes, nuestro equipo ha
          sido notificado y está trabajando para solucionarlo.
        </p>
        {
          process.env.NODE_ENV === "development" && (
            <details class="max-w-lg p-4 mx-auto mt-6 text-left border border-red-200 rounded-lg bg-red-50">
              <summary class="font-medium text-red-700 cursor-pointer">
                Detalles del error (desarrollo)
              </summary>
              <pre class="mt-2 text-sm text-red-600 wrap-break-word whitespace-pre-wrap">
                {error.message}
              </pre>
            </details>
          )
        }
      </section>
      <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
        <button
          type="button"
          onclick="window.location.reload()"
          class="flex items-center gap-3 px-8 py-4 font-semibold transition-all duration-200 transform rounded-full shadow-lg text-neutral-200 group bg-linear-to-r from-orange-pantone to-medium-slate-blue hover:shadow-xl hover:scale-105"
        >
          Intentar de nuevo
        </button>
        <a
          href="/"
          class="flex items-center gap-3 px-8 py-4 font-semibold text-gray-700 transition-all duration-200 transform bg-white border-2 border-gray-200 rounded-full shadow-lg hover:shadow-xl hover:border-orange-pantone/30 hover:scale-105"
        >
          Volver al inicio
        </a>
      </div>
      <div
        class="absolute rounded-full size-20 top-20 left-10 bg-medium-slate-blue/20 blur-xl"
      >
      </div>
      <div
        class="absolute rounded-full size-32 bottom-20 right-10 bg-orange-pantone/20 blur-xl"
      >
      </div>
    </div>
  </Main>
</Layout>
